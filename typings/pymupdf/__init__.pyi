"""Small, explicit type surface for PyMuPDF APIs used by this application."""

from collections.abc import Iterator
from pathlib import Path
from typing import Any

class Rect:
    width: float
    height: float
    def __init__(self, x0: float, y0: float, x1: float, y1: float) -> None: ...

class Matrix:
    def __init__(self, a: float, b: float) -> None: ...

class Pixmap:
    width: int
    height: int
    def save(self, filename: str | Path) -> None: ...

class Page:
    rect: Rect
    rotation: int
    def get_text(self, option: str = ..., **kwargs: Any) -> str: ...
    def set_rotation(self, rotation: int) -> None: ...
    def insert_textbox(self, rect: Rect, buffer: str, **kwargs: Any) -> float: ...
    def get_pixmap(self, *, matrix: Matrix | None = ..., alpha: bool = ...) -> Pixmap: ...
    def get_images(self, full: bool = ...) -> list[tuple[Any, ...]]: ...

class Document:
    page_count: int
    is_encrypted: bool
    def __enter__(self) -> Document: ...
    def __exit__(self, *args: Any) -> None: ...
    def close(self) -> None: ...
    def save(self, filename: str | Path, **kwargs: Any) -> None: ...
    def new_page(self, pno: int = ..., width: float = ..., height: float = ...) -> Page: ...
    def __getitem__(self, index: int) -> Page: ...
    def __iter__(self) -> Iterator[Page]: ...

def open(filename: str | Path | None = ..., **kwargs: Any) -> Document: ...
