# Required to run the Telegram bot. Never commit a real .env file.
BOT_TOKEN=
POSTGRES_PASSWORD=
API_BIND=127.0.0.1

# Local defaults; compose service names are used inside Docker.
DATABASE_URL=postgresql+asyncpg://pdfbot:local-dev-change-this-password@postgres:5432/pdfbot
REDIS_URL=redis://redis:6379/0
STORAGE_ROOT=/data/files
TEMP_ROOT=/tmp/pdfbot

# Conservative limits; enforce against actual bytes and parsed content.
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=500
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=180
FILE_TTL_HOURS=24
RATE_LIMIT_PER_MINUTE=10

# Host port for the optional health API; bound to loopback by default.
API_PORT=8000
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=fa

# Optional AI backend. No AI calls occur without explicit configuration.
AI_PROVIDER=
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
